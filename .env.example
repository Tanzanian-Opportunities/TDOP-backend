# Copy this file to `.env` (or set the variables in your shell)
# before starting the backend.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tdop
DB_USERNAME=postgres
# REQUIRED: your local PostgreSQL password
DB_PASSWORD=

# Required for production only. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# SMTP (optional; used for email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Public API base URL
APP_URL=http://localhost:8081/api/v1