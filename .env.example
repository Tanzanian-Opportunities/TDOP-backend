# =============================================================================
# TDOP Backend Environment Variables
# =============================================================================
# Copy this file to `.env` in the TDOP-backend directory and fill in your values.
#
#   cp .env.example .env
#
# The backend reads .env automatically on startup. Each developer uses their own.
# NEVER commit .env to git.
# =============================================================================

# PostgreSQL — use your LOCAL database credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tdop
DB_USERNAME=postgres
# REQUIRED: your local PostgreSQL password (the one you set during install)
DB_PASSWORD=

# JWT secret — leave empty to use the built-in dev default
JWT_SECRET=

# SMTP (optional — needed only for email notifications)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Public API base URL
APP_URL=http://localhost:8080/api/v1
